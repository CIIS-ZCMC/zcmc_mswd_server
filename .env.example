APP_NAME="ZCMC MSWD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=

# Render pages on the server. `composer dev` starts the SSR server; set this to
# true to use it (INERTIA_SSR_URL defaults to http://127.0.0.1:13714). When it is
# off or unreachable the app falls back to client rendering.
INERTIA_SSR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Each page fires several API calls at once. `php artisan serve` is
# single-threaded without this, so those requests queue and the page appears to
# hang on load.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zcmc_mswd_server
DB_USERNAME=root
DB_PASSWORD=

# The hospital information system (HIS, Bizbox), read live and never written.
# Leave SQLSRV_DATABASE blank when you have no HIS access; tests never use it.
SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DATABASE=
SQLSRV_USERNAME=
SQLSRV_PASSWORD=
# SQLSRV_CHARSET=utf8
# DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Patient documents are stored on the default disk (FILESYSTEM_DISK) and read
# only through the server. Development uses RustFS, an S3-compatible store:
# set FILESYSTEM_DISK=s3 and point the AWS_* values at it (bucket `mss`).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# RustFS example:
# AWS_BUCKET=mss
# AWS_ENDPOINT=http://localhost:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
# Base path the browser calls the API on (default /api).
# VITE_API_URL=/api

# Which sign-in staff use: umis (the ZCMC Portal), iam (ZCMC IAM) or local
# (employee number + password on this server; accounts are made in /admin).
# local suits development, so seeded accounts of any role can sign in. Set umis
# in production.
AUTH_PROVIDER=local

# UMIS sign-in, used when AUTH_PROVIDER=umis. MSWD must be registered in UMIS
# ("Manage Systems") with its domain set to APP_URL.
UMIS_API_URL=https://umis.zcmc.online
UMIS_API_KEY=
# UMIS's API_PAYLOAD_KEY. Only needed while UMIS encrypts its replies; leave
# blank when UMIS encryption is off.
UMIS_PAYLOAD_KEY=
UMIS_SYSTEM_CODE=MSWD
UMIS_PORTAL_URL=
UMIS_RECHECK_MINUTES=5
UMIS_TIMEOUT=10

# Philippine Standard Geographic Code for address pickers. Only `php artisan
# psgc:sync` calls PSGC Cloud; the app reads the psgc_areas table (psgc:load).
PSGC_API_URL=https://psgc.cloud/api
PSGC_TIMEOUT=30
# Cities in this region come first in the picker (Region IX, Zamboanga Peninsula).
PSGC_HOME_REGION=0900000000

# ZCMC IAM single sign-on, used only when AUTH_PROVIDER=iam
# (redirect URI must be registered with IAM)
IAM_BASE_URL=https://iam.zcmc.online
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
IAM_REDIRECT_URI="${APP_URL}/callback"
IAM_MAX_AGE=
IAM_END_SESSION_ON_LOGOUT=true
